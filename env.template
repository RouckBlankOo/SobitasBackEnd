# Server Configuration
PORT=3001
NODE_ENV=production

# Database
MONGODB_URI=mongodb://localhost:27017/sobitas-db

# JWT Authentication
JWT_SECRET=your-secret-key-here-replace-with-strong-random-string
JWT_REFRESH_SECRET=your-refresh-secret-here-replace-with-strong-random-string
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Frontend URLs (for CORS)
ADMIN_FRONTEND_URL=https://admin.protein.tn
ECOMMERCE_FRONTEND_URL=https://protein.tn

# Redis Cache (optional)
REDIS_URL=redis://localhost:6379

# ISR Revalidation
REVALIDATE_SECRET=your-revalidate-secret-replace-with-strong-random-string

# AWS S3 (for file uploads)
AWS_S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=eu-west-1

